{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "index",
    "extensions/*/src",
    "*.test.ts",
    "*/*.test.ts",
    "extensions/*/*.test.ts"
  ],
  "exclude": [
    "sdk",
    "theme",
    "node_modules"
  ]
}
