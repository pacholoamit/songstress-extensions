{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.nocturne",
  "name": "Nocturne",
  "version": "1.0.0",
  "description": "A late-night room: deep indigo, lit in saffron.",
  "engines": {
    "songstress": "^0.1.3"
  },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": [
    "themes"
  ],
  "keywords": [
    "nocturne",
    "indigo",
    "saffron"
  ],
  "icon": {
    "path": "assets/icon.png",
    "width": 512,
    "height": 512
  },
  "contributes": {
    "themes": [
      {
        "id": "nocturne",
        "label": "Nocturne",
        "appearance": "dark",
        "path": "themes/nocturne.json"
      }
    ]
  }
}
