{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.gruvbox",
  "name": "Gruvbox",
  "version": "1.0.1",
  "description": "Gruvbox's retro groove: warm browns and creams with orange, for dark and for light.",
  "engines": {
    "songstress": "^0.1.3"
  },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": [
    "themes"
  ],
  "keywords": [
    "gruvbox",
    "retro",
    "warm"
  ],
  "icon": {
    "path": "assets/icon.png",
    "width": 512,
    "height": 512
  },
  "screenshots": [
    {
      "path": "assets/screenshots/home-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Gruvbox, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Gruvbox, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Gruvbox, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/home-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Gruvbox, light",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Gruvbox, light",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Gruvbox, light",
      "platform": "web"
    }
  ],
  "contributes": {
    "themes": [
      {
        "id": "gruvbox",
        "label": "Gruvbox",
        "appearance": "both",
        "path": "themes/gruvbox.json"
      }
    ]
  }
}
