{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.studio",
  "name": "Studio",
  "version": "1.0.1",
  "description": "A graphite console with one signal light: lime for dark, and for the day an olive pen with lime buttons.",
  "engines": {
    "songstress": "^0.1.3"
  },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": [
    "themes"
  ],
  "keywords": [
    "studio",
    "graphite",
    "lime"
  ],
  "icon": {
    "path": "assets/icon.png",
    "width": 512,
    "height": 512
  },
  "screenshots": [
    {
      "path": "assets/screenshots/home-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Studio, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Studio, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Studio, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/home-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Studio, light",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Studio, light",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Studio, light",
      "platform": "web"
    }
  ],
  "contributes": {
    "themes": [
      {
        "id": "studio",
        "label": "Studio",
        "appearance": "both",
        "path": "themes/studio.json"
      }
    ]
  }
}
