{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.nocturne",
  "name": "Nocturne",
  "version": "1.0.2",
  "description": "A late-night room: deep indigo, lit in saffron.",
  "engines": {
    "songstress": "^0.1.10"
  },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": [
    "themes"
  ],
  "keywords": [
    "nocturne",
    "indigo",
    "saffron"
  ],
  "icon": {
    "path": "assets/icon.png",
    "width": 512,
    "height": 512
  },
  "screenshots": [
    {
      "path": "assets/screenshots/home.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Nocturne",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Nocturne",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Nocturne",
      "platform": "web"
    }
  ],
  "contributes": {
    "themes": [
      {
        "id": "nocturne",
        "label": "Nocturne",
        "appearance": "dark",
        "path": "themes/nocturne.json"
      }
    ]
  }
}
