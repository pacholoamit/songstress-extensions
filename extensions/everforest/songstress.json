{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.everforest",
  "name": "Everforest",
  "version": "1.0.1",
  "description": "Everforest's green, warm and soft: a forest at dusk for dark, and at noon for light.",
  "engines": {
    "songstress": "^0.1.3"
  },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": [
    "themes"
  ],
  "keywords": [
    "everforest",
    "green",
    "soft"
  ],
  "icon": {
    "path": "assets/icon.png",
    "width": 512,
    "height": 512
  },
  "screenshots": [
    {
      "path": "assets/screenshots/home-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Everforest, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Everforest, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Everforest, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/home-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Everforest, light",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Everforest, light",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Everforest, light",
      "platform": "web"
    }
  ],
  "contributes": {
    "themes": [
      {
        "id": "everforest",
        "label": "Everforest",
        "appearance": "both",
        "path": "themes/everforest.json"
      }
    ]
  }
}
