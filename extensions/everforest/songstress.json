{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.everforest",
  "name": "Everforest",
  "version": "1.0.0",
  "description": "Everforest's green, warm and soft: a forest at dusk for dark, and at noon for light.",
  "engines": {
    "songstress": "^0.1.3"
  },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": [
    "themes"
  ],
  "keywords": [
    "everforest",
    "green",
    "soft"
  ],
  "icon": {
    "path": "assets/icon.png",
    "width": 512,
    "height": 512
  },
  "contributes": {
    "themes": [
      {
        "id": "everforest",
        "label": "Everforest",
        "appearance": "both",
        "path": "themes/everforest.json"
      }
    ]
  }
}
