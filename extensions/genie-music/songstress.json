{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.genie-music",
  "name": "Genie Music",
  "version": "1.0.1",
  "description": "Search Genie Music's songs, albums and artists, and open them from a link.",
  "engines": { "songstress": "^0.1.0" },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": ["sources"],
  "keywords": ["genie", "k-pop", "korea"],
  "icon": { "path": "assets/icon.png", "width": 512, "height": 512 },
  "screenshots": [
    { "path": "assets/screenshots/albums.webp", "width": 1440, "height": 900, "caption": "Albums and artists from Genie Music in Search", "platform": "web" },
    { "path": "assets/screenshots/artists.webp", "width": 1440, "height": 900, "caption": "Search for “NewJeans”, Genie Music alone", "platform": "web" },
    { "path": "assets/screenshots/extension.webp", "width": 1440, "height": 900, "caption": "Genie Music under Manage, Extensions: what it may do", "platform": "web" }
  ],
  "entry": { "server": "dist/server.js" },
  "permissions": {
    "network": {
      "reason": "Read Genie Music's search and detail pages, and its cover images.",
      "hosts": ["www.genie.co.kr", "genie.co.kr", "image.genie.co.kr"]
    },
    "providers": { "reason": "Add Genie Music's results beside Songstress's own sources." }
  },
  "contributes": {
    "providers": {
      "search": [{ "id": "genie-music", "types": ["track", "album", "artist"] }],
      "lookup": [{ "id": "genie-music", "types": ["track", "album", "artist"] }],
      "links": [{ "id": "genie-music", "patterns": ["genie.co.kr/detail/songInfo", "genie.co.kr/detail/albumInfo", "genie.co.kr/detail/artistInfo"] }]
    }
  }
}
