{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.rose-pine",
  "name": "Rosé Pine",
  "version": "1.0.2",
  "description": "Rosé Pine's soho vibes: Main and Moon for dark, Dawn for light.",
  "engines": {
    "songstress": "^0.1.10"
  },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": [
    "themes"
  ],
  "keywords": [
    "rose-pine",
    "pink",
    "muted"
  ],
  "icon": {
    "path": "assets/icon.png",
    "width": 512,
    "height": 512
  },
  "screenshots": [
    {
      "path": "assets/screenshots/home-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Rosé Pine, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Rosé Pine, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Rosé Pine, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/home-moon.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Rosé Pine Moon",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/home-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Rosé Pine, light",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Rosé Pine, light",
      "platform": "web"
    }
  ],
  "contributes": {
    "themes": [
      {
        "id": "rose-pine",
        "label": "Rosé Pine",
        "appearance": "both",
        "path": "themes/rose-pine.json"
      },
      {
        "id": "rose-pine-moon",
        "label": "Rosé Pine Moon",
        "appearance": "dark",
        "path": "themes/rose-pine-moon.json"
      }
    ]
  }
}
