{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.tokyo-night",
  "name": "Tokyo Night",
  "version": "1.0.2",
  "description": "Tokyo Night's city lights after dark, and Tokyo Night Light for the day.",
  "engines": {
    "songstress": "^0.1.10"
  },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": [
    "themes"
  ],
  "keywords": [
    "tokyo-night",
    "blue",
    "night"
  ],
  "icon": {
    "path": "assets/icon.png",
    "width": 512,
    "height": 512
  },
  "screenshots": [
    {
      "path": "assets/screenshots/home-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Tokyo Night, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Tokyo Night, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-dark.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Tokyo Night, dark",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/home-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Tokyo Night, light",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Tokyo Night, light",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player-light.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Tokyo Night, light",
      "platform": "web"
    }
  ],
  "contributes": {
    "themes": [
      {
        "id": "tokyo-night",
        "label": "Tokyo Night",
        "appearance": "both",
        "path": "themes/tokyo-night.json"
      }
    ]
  }
}
