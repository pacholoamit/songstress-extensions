{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "songstress.kanagawa",
  "name": "Kanagawa",
  "version": "1.0.1",
  "description": "Kanagawa's ink and wave, after Hokusai: Kanagawa Wave, for dark.",
  "engines": {
    "songstress": "^0.1.3"
  },
  "license": "MIT",
  "repository": "https://github.com/pacholoamit/songstress-extensions",
  "categories": [
    "themes"
  ],
  "keywords": [
    "kanagawa",
    "ink",
    "wave"
  ],
  "icon": {
    "path": "assets/icon.png",
    "width": 512,
    "height": 512
  },
  "screenshots": [
    {
      "path": "assets/screenshots/home.webp",
      "width": 1440,
      "height": 900,
      "caption": "Home in Kanagawa",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/playlist.webp",
      "width": 1440,
      "height": 900,
      "caption": "A playlist in Kanagawa",
      "platform": "web"
    },
    {
      "path": "assets/screenshots/player.webp",
      "width": 1440,
      "height": 900,
      "caption": "The full-screen player in Kanagawa",
      "platform": "web"
    }
  ],
  "contributes": {
    "themes": [
      {
        "id": "kanagawa",
        "label": "Kanagawa",
        "appearance": "dark",
        "path": "themes/kanagawa.json"
      }
    ]
  }
}
