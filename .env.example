# For `pnpm dev <folder>`: the Songstress server to install an extension on while
# you work, and an admin of it. Copy this file to .env, which git ignores.
SONGSTRESS_SERVER=http://localhost:8090
SONGSTRESS_EMAIL=you@example.com
SONGSTRESS_PASSWORD=
# Or, in place of the email and password, an admin's session token:
# SONGSTRESS_TOKEN=
