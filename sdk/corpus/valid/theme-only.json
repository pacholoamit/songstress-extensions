{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "nightowl.midnight-garden",
  "name": "Midnight Garden",
  "version": "1.0.0",
  "description": "Deep greens and warm amber: a dark look written out in every form of colour, one grown from a seed, and a garden of both looks in a file.",
  "engines": {
    "songstress": "^0.1.3"
  },
  "license": "MIT",
  "categories": [
    "themes"
  ],
  "keywords": [
    "dark",
    "green",
    "amber"
  ],
  "contributes": {
    "themes": [
      {
        "id": "midnight-garden",
        "label": "Midnight Garden",
        "appearance": "dark",
        "dark": {
          "colors": {
            "background": "#07110c",
            "surface": "rgb(16, 32, 26)",
            "surface.hover": "rgb(238 245 238 / 8%)",
            "border": "#EEF5EE1F",
            "text": "#eef5ee",
            "text.muted": "hsl(135 12% 82%)",
            "accent": "hsl(36deg 89% 65%)",
            "accent.onFill": "rgba(26, 18, 4, 1)"
          },
          "glow": [
            "#f5b556",
            "#3f8f63"
          ]
        }
      },
      {
        "id": "greenhouse",
        "label": "Greenhouse",
        "appearance": "dark",
        "dark": {
          "seed": "#7e0"
        }
      },
      {
        "id": "garden",
        "label": "Garden",
        "appearance": "both",
        "path": "themes/garden.json"
      }
    ]
  }
}
