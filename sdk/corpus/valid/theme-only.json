{
  "$schema": "https://songstress.app/schema/extension/v1.json",
  "manifestVersion": 1,
  "id": "nightowl.midnight-garden",
  "name": "Midnight Garden",
  "version": "1.0.0",
  "description": "Three dark themes in deep greens and warm amber.",
  "engines": {
    "songstress": "^0.1.0"
  },
  "license": "MIT",
  "categories": [
    "themes"
  ],
  "keywords": [
    "dark",
    "green",
    "amber"
  ],
  "contributes": {
    "themes": [
      {
        "id": "midnight-garden",
        "label": "Midnight Garden",
        "path": "themes/midnight-garden.json"
      },
      {
        "id": "greenhouse",
        "label": "Greenhouse",
        "path": "themes/greenhouse.json"
      }
    ]
  }
}
