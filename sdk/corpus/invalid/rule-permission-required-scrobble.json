{
  "manifestVersion": 1,
  "id": "acme.example",
  "name": "Example",
  "version": "1.0.0",
  "description": "An example extension.",
  "engines": {
    "songstress": "^0.1.0"
  },
  "entry": {
    "server": "dist/server.js"
  },
  "permissions": {
    "providers": {
      "reason": "Report each member's plays to Example."
    },
    "network": {
      "reason": "Reach the Example service.",
      "hosts": [
        "api.example.com"
      ]
    }
  },
  "contributes": {
    "providers": {
      "scrobble": [
        {
          "id": "example"
        }
      ]
    }
  }
}
