{
  "manifestVersion": 1,
  "id": "acme.example",
  "name": "Example",
  "version": "1.0.0",
  "description": "An example extension.",
  "engines": {
    "songstress": "^0.1.0"
  },
  "entry": {
    "server": "dist/server.js"
  },
  "hooks": {
    "server": [
      "onScrobble"
    ]
  },
  "permissions": {
    "listening.read": {
      "reason": "Needed for what the extension does."
    },
    "providers": {
      "reason": "Needed for what the extension does."
    }
  },
  "contributes": {
    "providers": {
      "links": [
        {
          "id": "links",
          "patterns": [
            "example.com",
            "https:",
            "http:",
            "exampleapp:"
          ]
        }
      ]
    }
  }
}
