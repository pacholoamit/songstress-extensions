{
  "manifestVersion": 1,
  "id": "acme.example",
  "name": "Example",
  "version": "1.0.0",
  "description": "An example extension.",
  "engines": {
    "songstress": "^0.1.0"
  },
  "entry": {
    "server": "dist/server.js"
  },
  "hooks": {
    "server": [
      "onScrobble"
    ]
  },
  "permissions": {
    "listening.read": {
      "reason": "Needed for what the extension does."
    },
    "network.local": {
      "reason": "Needed for what the extension does.",
      "targets": [
        "192.168.1.20",
        "8.8.8.8",
        "169.254.169.254",
        "10.0.0.0/8",
        "100.100.100.200",
        "192.168.0.0/15",
        "10.0.0.0/7",
        "nas.local",
        "0.0.0.0/0",
        "172.32.0.1",
        "11.0.0.1:8080",
        "172.31.0.0/16",
        "127.0.0.1:8096",
        "128.0.0.1"
      ]
    }
  }
}
