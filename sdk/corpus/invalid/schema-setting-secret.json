{
  "manifestVersion": 1,
  "id": "acme.example",
  "name": "Example",
  "version": "1.0.0",
  "description": "An example extension.",
  "engines": {
    "songstress": "^0.1.0"
  },
  "contributes": {
    "settings": [
      {
        "key": "token",
        "type": "secret",
        "title": "Token",
        "scope": "device"
      },
      {
        "key": "password",
        "type": "secret",
        "title": "Password",
        "scope": "user",
        "default": "hunter2"
      }
    ]
  }
}
