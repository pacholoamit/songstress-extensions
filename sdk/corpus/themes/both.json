  "$schema": "https://songstress.app/schema/theme/v1.json",
  "dark": {
    "colors": {
      "background": "#07110c",
      "surface": "#10201a",
      "surface.raised": "#172b23",
      "surface.hover": "#eef5ee14",
      "border": "#24382f",
